rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Perfiles de usuario (Google Auth)
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Entrenamientos GPS (Workouts) y telemetría en vivo
    match /workouts/{workoutId} {
      allow read: if true;
      allow create, update: if true; // Permite sincronización desde WebAPK / Android y OAuth

      // Subcolección de Peptalks en tiempo real (cualquier amigo puede enviar ánimos)
      match /peptalks/{peptalkId} {
        allow read, create: if true;
      }
    }

    // 3. Retos Clásicos de Endomondo (Challenges)
    match /challenges/{challengeId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }
  }
}
