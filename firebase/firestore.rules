rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Perfiles de usuario (Google Auth)
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Entrenamientos GPS (Workouts) y telemetría en vivo
    match /workouts/{workoutId} {
      allow read: if true;
      allow create, update: if true;

      // Subcolección de Peptalks en tiempo real
      match /peptalks/{peptalkId} {
        allow read, create: if true;
      }
    }

    // 3. Eventos de Google Analytics 4 (G-3QDD46L6S4)
    match /analytics_events/{eventId} {
      allow read, create: if true;
    }

    // 4. Informes de fallos y excepciones de Crashlytics
    match /crashlytics_reports/{reportId} {
      allow read, create, update: if true;
    }

    // 5. Retos Clásicos de Endomondo (Challenges)
    match /challenges/{challengeId} {
      allow read, create, update: if true;
    }
  }
}
